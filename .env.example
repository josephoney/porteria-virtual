# PostgreSQL + TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=porteria
POSTGRES_USER=porteria
POSTGRES_PASSWORD=porteria_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001

# API Server
API_PORT=3000
API_HOST=0.0.0.0

# Asset storage (local by default; use s3 in production)
ASSET_STORAGE=local
ASSET_LOCAL_DIR=uploads
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

#si
 Signaling Server
SIGNALING_PORT=3001
SIGNALING_HOST=0.0.0.0

# JWT
JWT_SECRET=change-me-in-production-use-a-strong-random-string
JWT_REFRESH_SECRET=change-me-in-production-use-another-strong-random-string
# Tenant entry
PUBLIC_APP_URL=http://localhost:5174
INVITATION_EXPIRY_DAYS=7

# Feature flags
CONFIGURABLE_LOCATION_HIERARCHY=true

# Outbox
OUTBOX_WORKER_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_DAYS=7
OUTBOX_LAG_WARN_SECONDS=60