# ---------------------------------------------------------------------------
# Porteria Virtual — development defaults
# Copy to .env and adjust. Production values must be provided by the platform.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info

# API
API_PORT=3000
API_HOST=0.0.0.0
TRUST_PROXY=false
REQUEST_BODY_LIMIT_BYTES=1048576

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=porteria
POSTGRES_USER=porteria
POSTGRES_PASSWORD=porteria_dev
# The demo seed refuses to run in production unless this is explicitly true.
SEED_DEMO_DATA=false

# First production admin (only used by pnpm --filter @porteria/database db:bootstrap)
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_SLUG=
BOOTSTRAP_COMMUNITY_NAME=
BOOTSTRAP_COMMUNITY_SLUG=
BOOTSTRAP_COMMUNITY_ADDRESS=
BOOTSTRAP_COMMUNITY_TIMEZONE=America/Bogota
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_FORCE_PASSWORD=false
BOOTSTRAP_PLATFORM_ADMIN=false
BOOTSTRAP_ACCESS_POINT_NAME=Portón Principal

# Redis (reserved for distributed rate limiting / queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_BRIDGE_PORT=3002
MQTT_BRIDGE_URL=http://localhost:3002

# Auth — use at least 32 random characters in production
JWT_SECRET=change-me-in-production-use-a-strong-random-string
JWT_REFRESH_SECRET=change-me-in-production-use-another-strong-random-string
AUTH_LOGIN_RATE_LIMIT=10

# Public URLs
PUBLIC_APP_URL=http://localhost:5174
PASS_WEB_URL=http://localhost:5176
INVITATION_EXPIRY_DAYS=7

# CORS — comma-separated allowlist. Required in production.
CORS_ORIGINS=http://localhost:5174,http://localhost:5176,http://localhost:5173

# Cookies / headers
COOKIE_SECURE=false
HSTS_MAX_AGE_SECONDS=15552000

# Feature flags
CONFIGURABLE_LOCATION_HIERARCHY=true
DYNAMIC_QR_ENABLED=false

# Dynamic QR
PASS_QR_SECRET=change-me-in-production-use-a-strong-random-string
PASS_QR_TTL_SECONDS=24
PASS_LINK_TTL_MINUTES=1440
PASS_PIN_ATTEMPTS=5
PASS_PIN_LOCK_MINUTES=15
PASS_SCAN_PENDING_TTL_SECONDS=180
PASS_MISSING_EXIT_GRACE_MINUTES=15
PASS_DAILY_LIMIT_PER_UNIT=20
PASS_RATE_LIMIT_PREVIEW=60
PASS_RATE_LIMIT_BIND=20
PASS_RATE_LIMIT_QR=60
PASS_RATE_LIMIT_STATUS=120

# Guard shifts
GUARD_SHIFT_MAX_HOURS=16

# Internal API key — required in production
INTERNAL_API_KEY=dev-internal-key-change-me

# Outbox worker
OUTBOX_WORKER_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_DAYS=7
OUTBOX_LAG_WARN_SECONDS=60

# Observability
METRICS_ENABLED=true
# SENTRY_DSN=

# Assets (local by default; use s3 in production)
ASSET_STORAGE=local
ASSET_LOCAL_DIR=uploads
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Signaling server
SIGNALING_PORT=3001
SIGNALING_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5174
API_BASE_URL=http://localhost:3000
