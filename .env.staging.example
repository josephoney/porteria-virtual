# Copiar a .env.staging y completar. No versionar el archivo con secretos.
#
#   cp .env.staging.example .env.staging

# Dominio ya apuntado con un registro A a este servidor.
# Sin esto Caddy no puede emitir el certificado.
STAGING_DOMAIN=staging.midominio.com

# Base de datos
POSTGRES_DB=porteria
POSTGRES_USER=porteria
POSTGRES_PASSWORD= cambiar-por-uno-largo

# Secretos de la aplicación
# Generar con: openssl rand -hex 48
JWT_SECRET=cambiar-por-uno-largo
# Firma el token de refresco. Mínimo 32 caracteres.
JWT_REFRESH_SECRET=cambiar-por-uno-de-al-menos-32
# Autentica llamadas internas entre servicios.
INTERNAL_API_KEY=cambiar-por-uno-de-al-menos-32
# Mínimo 32 caracteres: cifra el enlace del pase y firma el QR.
PASS_QR_SECRET=cambiar-por-uno-de-al-menos-32

# Límites y comportamiento
DYNAMIC_QR_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10
PASS_DAILY_LIMIT_PER_UNIT=50
PASS_ALERT_INTERVAL_MINUTES=5
