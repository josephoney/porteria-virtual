# Los builds de React Native (Gradle y el autolinking de Expo) no siguen los
# enlaces simbólicos que pnpm crea por defecto en node_modules. Con el layout
# "hoisted" los paquetes quedan planos, como con npm, y el build nativo los
# encuentra.
#
# EAS lee este archivo al compilar. También aplica en local, así que después de
# cambiarlo hace falta un `pnpm install` limpio.
node-linker=hoisted
