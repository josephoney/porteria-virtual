[Unit]
Description=Porteria Virtual Relay Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/porteria/relay-daemon
ExecStart=/usr/bin/python3 /opt/porteria/relay-daemon/relay-daemon.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
