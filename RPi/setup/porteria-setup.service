[Unit]
Description=Porteria Virtual — Setup Wizard
After=multi-user.target network-online.target
Before=display-manager.service
ConditionPathExists=!/opt/porteria/.configured

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/porteria/setup/setup-wizard.sh
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
