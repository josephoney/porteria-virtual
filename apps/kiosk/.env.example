# Kiosk — environment variables
# Copy this file to .env and adjust as needed.

# Override the signaling (Socket.IO) server URL.
# When set, this takes precedence over automatic detection.
# Leave empty to auto-detect based on protocol and hostname.
#VITE_SIGNALING_URL=http://localhost:3001

# Building identifier sent to the signaling server on registration.
#VITE_BUILDING_ID=edificio-01


# Building display name shown in the kiosk UI.
#VITE_BUILDING_NAME=EDIFICIO PRINCIPAL
