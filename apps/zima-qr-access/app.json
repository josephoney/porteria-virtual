{
  "expo": {
    "name": "Zima QR Access",
    "slug": "zima-qr-access",
    "scheme": "zima-qr-access",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.porteria.zimaqraccess",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.porteria.zimaqraccess",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Zima QR Access necesita la cámara para escanear pases.",
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9a5530b7-3753-43a3-baf9-072dd24969b1"
      }
    },
    "owner": "zima-seguridad-tech"
  }
}
