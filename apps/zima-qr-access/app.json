{
  "expo": {
    "name": "Zima QR Access",
    "slug": "zima-qr-access",
    "scheme": "zima-qr-access",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.porteria.zimaqraccess",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.porteria.zimaqraccess",
      "permissions": ["CAMERA"],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Zima QR Access necesita la cámara para escanear pases."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
