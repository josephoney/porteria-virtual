# ─── Dominios (sin protocolo) ───────────────────────────────────────────────
DASHBOARD_HOST=app.porteria.example
PASS_WEB_HOST=pases.porteria.example
ACME_EMAIL=ops@porteria.example

# ─── API ────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=info
API_PORT=3000
API_HOST=0.0.0.0
TRUST_PROXY=true
REQUEST_BODY_LIMIT_BYTES=1048576

# ─── Base de datos ──────────────────────────────────────────────────────────
POSTGRES_DB=porteria
POSTGRES_USER=porteria
POSTGRES_PASSWORD=CAMBIA-ESTA-CLAVE-POR-UNA-FUERTE
POSTGRES_PORT=5432

# ─── Secretos (mínimo 32 caracteres; generá con openssl rand -hex 32) ──────
JWT_SECRET=CAMBIA-ESTO-POR-UN-SECRETO-DE-32-O-MAS-CARACTERES
JWT_REFRESH_SECRET=CAMBIA-ESTO-POR-OTRO-SECRETO-DE-32-O-MAS-CARACTERES
PASS_QR_SECRET=CAMBIA-ESTO-POR-UN-SECRETO-QR-DE-32-O-MAS-CARACTERES
INTERNAL_API_KEY=CAMBIA-ESTA-API-KEY-INTERNA

# ─── URLs públicas ──────────────────────────────────────────────────────────
CORS_ORIGINS=https://app.porteria.example,https://pases.porteria.example
PUBLIC_APP_URL=https://app.porteria.example
PASS_WEB_URL=https://pases.porteria.example
COOKIE_SECURE=true
HSTS_MAX_AGE_SECONDS=15552000

# ─── Features ───────────────────────────────────────────────────────────────
CONFIGURABLE_LOCATION_HIERARCHY=true
DYNAMIC_QR_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10
INVITATION_EXPIRY_DAYS=7
SEED_DEMO_DATA=false

# First production admin (docker compose --profile bootstrap run --rm bootstrap)
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_SLUG=
BOOTSTRAP_COMMUNITY_NAME=
BOOTSTRAP_COMMUNITY_SLUG=
BOOTSTRAP_COMMUNITY_ADDRESS=
BOOTSTRAP_COMMUNITY_TIMEZONE=America/Bogota
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_FORCE_PASSWORD=false
BOOTSTRAP_PLATFORM_ADMIN=false
BOOTSTRAP_ACCESS_POINT_NAME=Portón Principal

# ─── Pases / QR ─────────────────────────────────────────────────────────────
PASS_QR_TTL_SECONDS=24
PASS_LINK_TTL_MINUTES=1440
PASS_PIN_ATTEMPTS=5
PASS_PIN_LOCK_MINUTES=15
PASS_SCAN_PENDING_TTL_SECONDS=180
PASS_MISSING_EXIT_GRACE_MINUTES=15
PASS_DAILY_LIMIT_PER_UNIT=20
PASS_RATE_LIMIT_PREVIEW=60
PASS_RATE_LIMIT_BIND=20
PASS_RATE_LIMIT_QR=60
PASS_RATE_LIMIT_STATUS=120

# ─── Turnos ─────────────────────────────────────────────────────────────────
GUARD_SHIFT_MAX_HOURS=16

# ─── Outbox ─────────────────────────────────────────────────────────────────
OUTBOX_WORKER_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_DAYS=7
OUTBOX_LAG_WARN_SECONDS=60

# ─── Observabilidad ─────────────────────────────────────────────────────────
METRICS_ENABLED=true
# Reservado: el DSN se documenta, pero el SDK de Sentry todavía no está cableado.
SENTRY_DSN=

# ─── Signaling ──────────────────────────────────────────────────────────────
SIGNALING_PORT=3001
SIGNALING_HOST=0.0.0.0
CORS_ORIGIN=https://app.porteria.example
API_BASE_URL=http://api:3000

# ─── MQTT bridge (perfil opcional "mqtt") ───────────────────────────────────
MQTT_BRIDGE_PORT=3002
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_BRIDGE_URL=http://mqtt-bridge:3002

# ─── Assets / storage ───────────────────────────────────────────────────────
# local: usa el volumen uploads montado en /data/uploads.
# s3: configurá ASSET_STORAGE=s3 y las variables S3_*.
ASSET_STORAGE=local
ASSET_LOCAL_DIR=/data/uploads
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
