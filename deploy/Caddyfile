# Caddyfile de staging: un dominio, todos los servicios detrás.
#
# El dominio llega por variable de entorno para no hardcodearlo en el repo:
#   STAGING_DOMAIN=staging.midominio.com
#
# Caddy pide el certificado solo, siempre que el DNS apunte a este servidor.

{$STAGING_DOMAIN} {
	encode zstd gzip

	# Healthcheck público del API. Sin esta ruta cae en el fallback del
	# dashboard y responde HTML con un 200 engañoso.
	handle /health {
		reverse_proxy api:3000
	}

	# La API ya espera el prefijo /api, así que no se reescribe.
	handle /api/* {
		reverse_proxy api:3000 {
			# Los streams SSE (bitácora y pases) necesitan que nada se bufferee:
			# sin esto el navegador recibe los eventos de a bloques.
			flush_interval -1
		}
	}

	# Pase de visita público: las URLs son /p/<token>.
	handle /p/* {
		root * /srv/pass-web
		try_files {path} /index.html
		file_server
	}

	# El kiosco compila con base /kiosk/, así que sus assets viven bajo esa
	# ruta: se sirve desde /srv para que /kiosk/assets/x.js resuelva.
	handle /kiosk/* {
		root * /srv
		try_files {path} /kiosk/index.html
		file_server
	}

	# Todo lo demás es el dashboard.
	handle {
		root * /srv/dashboard
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
