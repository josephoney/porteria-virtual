[Unit]
Description=Respaldo de PostgreSQL de Porteria Virtual
Documentation=file:///root/porteria/deploy/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/porteria
Nice=10
IOSchedulingClass=idle
# backup.sh lee BACKUP_* del .env.staging o deploy/.env.production.
# Si el repo o el usuario cambian, ajusta WorkingDirectory y User.
ExecStart=/usr/bin/env bash /root/porteria/deploy/backup.sh

# Un respaldo fallido debe dejar rastro en journalctl y, si esta configurado,
# disparar la alerta de systemd (OnFailure=).
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30min
