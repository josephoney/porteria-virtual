[Unit]
Description=Respaldo diario de PostgreSQL de Porteria Virtual

[Timer]
# 03:30 UTC. Ajusta la hora a una ventana de baja actividad de tu operacion.
OnCalendar=*-*-* 03:30:00 UTC
# Si el servidor estaba apagado a esa hora, corre al arrancar.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
