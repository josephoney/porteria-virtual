%%   GRIS   = infraestructura
flowchart TB
  subgraph APPS["apps/ — Frontends"]
    KIOSK["kiosk<br/>React + Vite<br/>Terminal táctil RPi"]
    DASH["dashboard<br/>React + Vite + shadcn<br/>Admin · Operador · Guardia"]
    RES["resident<br/>React PWA<br/>Residentes"]
  end

  subgraph PACKAGES["packages/ — Código compartido"]
    SHARED["shared<br/>tipos · DTOs · enums"]
    DBPKG["database<br/>Drizzle schema · migrations · seed"]
  end

  subgraph SERVER["server/ — Backend"]
    API["api<br/>Fastify · REST"]
    RT["realtime<br/>(signaling) · Socket.io<br/>llamadas · chat · alertas"]
    DEVBR["device-bridge<br/>MQTT · adaptadores · outbox"]

    subgraph MODULES["server/api/src/modules/ — Contextos objetivo"]
      M_ID["identity"]
      M_TEN["tenancy"]
      M_ACC["access"]
      M_DEV["devices"]
      M_VIS["visitors"]
      M_ITC["intercom"]
      M_SEC["security-ops"]
      M_COM["communications"]
      M_SRV["services<br/>reservas · tickets · docs"]
      M_FIN["finance"]
      M_ANA["analytics"]
    end
  end

  subgraph INFRA["Infraestructura — docker compose"]
    PG[("PostgreSQL<br/>+ TimescaleDB")]
    REDIS[("Redis")]
    MQTT[("Mosquitto<br/>MQTT")]
    EDGE["nginx + coturn<br/>HTTPS · TURN"]
    OBJ[("Object Storage<br/>fotos · documentos")]
  end

  subgraph HW["Hardware de acceso"]
    BIO["Lector biométrico"]
    QRD["Lector QR"]
    TURN["Torniquete / barrera"]
    RELAY["Relés / GPIO"]
  end

