{
  "name": "porteria-virtual",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "dev:full": "concurrently -n signaling,apps -c yellow,cyan \"node legacy/server.js\" \"pnpm --recursive --parallel dev\"",
    "dev:clean": "npx kill-port 3001 3000 && concurrently -n signaling,apps -c yellow,cyan \"node legacy/server.js\" \"pnpm --recursive --parallel dev\"",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "pnpm --recursive clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
